# Include /api/v1 — same convention as VITE_*_API_BASE_URL.

#

# Local LAN (physical phone → PC backends): use http://<lan-ip>:port — not localhost.

# Backends must listen on 0.0.0.0. Prefer a debug build; Android release blocks HTTP.

#

# Production release APK: must use https:// (Android release forbids cleartext HTTP).

IDENTITY_API_BASE_URL=http://localhost:4011/api/v1

SMS_API_BASE_URL=http://localhost:4016/api/v1

EMAIL_API_BASE_URL=http://localhost:4014/api/v1

DATA_API_BASE_URL=http://localhost:4015/api/v1

# Optional when *_ORIGIN is set — derived as {origin}/api/v1
PAYMENT_API_BASE_URL=http://localhost:4017/api/v1

MEDIA_API_BASE_URL=http://localhost:4013/api/v1

WEBONONE_API_BASE_URL=http://localhost:4010/api/v1



# Peer frontend origins (in-app WebView screens such as Profile, Data, Email).

# Each *_ORIGIN should match the same environment as its API base when a WebView loads that service.

# IDENTITY_ORIGIN and WEBONONE_ORIGIN are derived from their API base URLs when omitted.

IDENTITY_ORIGIN=http://localhost:3011

EMAIL_ORIGIN=http://localhost:3014

DATA_ORIGIN=http://localhost:3015

PAYMENT_ORIGIN=http://localhost:3017

MEDIA_ORIGIN=http://localhost:3013

DESIGN_ORIGIN=http://localhost:3019

# Optional when DESIGN_ORIGIN is set — derived as {origin}/api/v1
DESIGN_API_BASE_URL=http://localhost:4019/api/v1

WEBONONE_ORIGIN=http://localhost:3010

SUPPORT_ORIGIN=http://localhost:3021

AI_ORIGIN=http://localhost:3020

# Optional when AI_ORIGIN is set — derived as {origin}/api/v1
AI_API_BASE_URL=http://localhost:4020/api/v1



# Google Sign-In (Android only). Same Web OAuth client ID as Identity.

# Leave empty to hide the Google button. Requires a dev/prebuild build (not Expo Go).

GOOGLE_WEB_CLIENT_ID=614019905250-ru7pmllv7of3jq24fnprhs7c0ni9rdgf.apps.googleusercontent.com



# Expo project ID (expo.dev → project settings). Required for OS tray push tokens.
# Must match the Expo project where Android FCM V1 service account is uploaded (see mobile/README.md).
# Leave empty to skip push registration (in-app bell still works).

EXPO_PROJECT_ID=



# Required for Android release bundles in this npm workspace monorepo.

EXPO_NO_METRO_WORKSPACE_ROOT=1

