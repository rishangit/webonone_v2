# Include /api/v1 — same convention as VITE_*_API_BASE_URL.
#
# Local LAN (physical phone → PC backends): use http://<lan-ip>:port — not localhost.
# Backends must listen on 0.0.0.0. Prefer a debug build; Android release blocks HTTP.
# Example: http://192.168.1.103:4011/api/v1
#
# Production release APK: must use https:// (Android release forbids cleartext HTTP).
# Example: https://identity.webonone.com/api/v1
IDENTITY_API_BASE_URL=http://localhost:4011/api/v1
SMS_API_BASE_URL=http://localhost:4016/api/v1

# Required for Android release bundles in this npm workspace monorepo.
# Keeps Metro's server root at mobile/ so ./index.js resolves correctly.
EXPO_NO_METRO_WORKSPACE_ROOT=1
