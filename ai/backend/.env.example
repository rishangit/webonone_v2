DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_ai

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4020

FRONTEND_BASE_URL=http://127.0.0.1:3020
WEBSITE_ORIGIN=http://127.0.0.1:3018
WEBONONE_ORIGIN=http://127.0.0.1:3010

# Guest/bootstrap provider only (anonymous website visitors).
# Signed-in users configure their own provider in WebOnOne Basic Settings → AI.
# Super-admin website guest defaults: same tab → Website guest assistant (or these values until saved).
AI_PROVIDER=ollama
AI_MODEL=llama3.1
AI_PROVIDER_BASE_URL=http://127.0.0.1:11434
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_MS=60000
# Optional — overrides built-in DEFAULT_SYSTEM_PROMPT
# AI_SYSTEM_PROMPT=

AI_GUEST_TOKEN_EXPIRY_SECONDS=86400
AI_GUEST_RATE_LIMIT_MAX=30
AI_GUEST_RATE_LIMIT_WINDOW_MS=60000

# Encrypts per-user and platform API keys in ai_provider_settings (32-byte hex or base64)
AI_CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Peer tool discovery (soft-degrades if unset or peer is down)
WEBONONE_API_BASE_URL=http://127.0.0.1:4010
WEBONONE_SERVICE_API_KEY=dev-webonone-service-key
DATA_API_BASE_URL=http://127.0.0.1:4015
DATA_SERVICE_API_KEY=dev-data-service-key
AI_CAPABILITY_REFRESH_MS=300000
AI_TOOL_HTTP_TIMEOUT_MS=15000
