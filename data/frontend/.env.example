VITE_API_BASE_URL=http://localhost:4015/api/v1
VITE_IDENTITY_ORIGIN=http://localhost:3011
VITE_IDENTITY_API_BASE_URL=http://localhost:4011/api/v1
VITE_WEBONONE_ORIGIN=http://localhost:3010
# Also used for dev CSP frame-ancestors when embedded in WebOnOne shell.
VITE_WEBONONE_API_BASE_URL=http://localhost:4010/api/v1
VITE_EMAIL_ORIGIN=http://localhost:3014
# Parent origins allowed to embed Data (postMessage + CSP frame-ancestors).
# Include both localhost and 127.0.0.1 variants; 3012 is the UI Kit showcase (embeds the tag picker).
VITE_ALLOWED_PARENT_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011,http://localhost:3012,http://127.0.0.1:3012

# Production (IIS): copy this file to frontend/.env.production before deploy
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_WEBONONE_ORIGIN=https://app.webonone.com
# VITE_WEBONONE_API_BASE_URL=https://app.webonone.com/api/v1
# VITE_EMAIL_ORIGIN=https://email.webonone.com
# VITE_ALLOWED_PARENT_ORIGINS=https://app.webonone.com,https://identity.webonone.com
#
# VITE_WEBONONE_ORIGIN is also used for dev CSP frame-ancestors (iframe embed from WebOnOne shell).
