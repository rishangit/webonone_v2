DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_data

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4015

FRONTEND_BASE_URL=http://127.0.0.1:3015

DATA_SERVICE_API_KEY=dev-data-service-key

# WebOnOne internal API (company catalog reference counts on library products/services/spaces)
WEBONONE_API_BASE_URL=http://127.0.0.1:4010
WEBONONE_SERVICE_API_KEY=dev-webonone-service-key

# Identity internal contact API (hydrate supplier names on stock reads)
IDENTITY_API_BASE_URL=http://127.0.0.1:4011
IDENTITY_SERVICE_API_KEY=dev-identity-service-key

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
