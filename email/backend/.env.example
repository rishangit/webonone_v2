DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_email
JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4004
EMAIL_SERVICE_API_KEY=dev-email-service-key
ALLOWED_PARENT_ORIGINS=http://localhost:3000,http://localhost:3001

# SMTP (outbound mail) — SMTP_PASSWORD required when SMTP_USER is set
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=WebOnOne
SMTP_TLS_REJECT_UNAUTHORIZED=true
FRONTEND_BASE_URL=http://localhost:3004
QUEUE_WORKER_INTERVAL_MS=5000

# Production (IIS): copy this file to backend/.env before deploy
#
# JWT_SECRET=<same as identity/backend/.env>
# EMAIL_SERVICE_API_KEY=<shared with identity and webonone backends>
# ALLOWED_PARENT_ORIGINS=https://app.webonone.com
