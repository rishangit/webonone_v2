DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_email

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4004

EMAIL_SERVICE_API_KEY=dev-email-service-key

# SMTP (outbound mail) — SMTP_PASSWORD required when SMTP_USER is set
SMTP_HOST=smtp.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@webonone.com
SMTP_PASSWORD=Linaya123!@@
SMTP_FROM_ADDRESS=noreply@webonone.com
SMTP_FROM_NAME=WebOnOne
SMTP_TLS_REJECT_UNAUTHORIZED=true
FRONTEND_BASE_URL=https://email.webonone.com
QUEUE_WORKER_INTERVAL_MS=5000

# Production (IIS): copy this file to backend/.env before deploy
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_email
# JWT_SECRET=<same-as-identity-backend-jwt-secret>
# HOST=127.0.0.1
# EMAIL_SERVICE_API_KEY=<shared-email-service-key>
# SMTP_HOST=<smtp-host>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<smtp-password>
# SMTP_FROM_ADDRESS=noreply@webonone.com
# SMTP_FROM_NAME=WebOnOne
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# FRONTEND_BASE_URL=https://email.webonone.com
# QUEUE_WORKER_INTERVAL_MS=5000
