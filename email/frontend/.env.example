VITE_API_BASE_URL=http://localhost:4004/api/v1
VITE_IDENTITY_ORIGIN=http://localhost:3001
VITE_IDENTITY_API_BASE_URL=http://localhost:4001/api/v1
VITE_WEBONONE_ORIGIN=http://localhost:3000
VITE_WEBONONE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DATA_ORIGIN=http://localhost:3005
VITE_ALLOWED_PARENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3004

# Production (IIS): copy this file to frontend/.env.production before deploy
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_WEBONONE_ORIGIN=https://app.webonone.com
# VITE_WEBONONE_API_BASE_URL=https://app.webonone.com/api/v1
# VITE_DATA_ORIGIN=https://data.webonone.com
# VITE_ALLOWED_PARENT_ORIGINS=https://app.webonone.com,https://identity.webonone.com
#
# Local dev: FE and BE run on different ports — set both origin and API base per peer service.
# Production (IIS): each service serves SPA + API from one host — API base is /api/v1 on same origin.
