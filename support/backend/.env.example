DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_support

# Must match Identity backend (JWT sign + verify)
JWT_SECRET=dev-jwt-secret-change-in-production

HOST=127.0.0.1
PORT=4021

FRONTEND_BASE_URL=http://127.0.0.1:3021

# Media API (validate feedback screenshot attachments)
MEDIA_API_BASE_URL=http://127.0.0.1:4013/api/v1

# Email service — feedback comment notifications (template slug: feedback_comment)
EMAIL_API_BASE_URL=http://127.0.0.1:4014
EMAIL_SERVICE_API_KEY=

# Same as Identity / WebOnOne — platform inbox for reporter → staff comment alerts
SUPER_ADMIN_EMAIL=superadmin@webonone.local

# /feedback-fix MCP + watcher — long-lived key (min 32 chars). Support BE validates this header on list/get/status.
# Generate: openssl rand -hex 32
# SUPPORT_FEEDBACK_AUTOMATION_API_KEY=
# SUPPORT_API_BASE_URL=http://127.0.0.1:4021/api/v1
# Optional legacy (expires): super_admin JWT from Support UI localStorage support_auth
# SUPPORT_FEEDBACK_BEARER_TOKEN=

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
