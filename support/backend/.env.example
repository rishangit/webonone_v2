DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_support

# Must match Identity backend (JWT sign + verify)
JWT_SECRET=dev-jwt-secret-change-in-production

HOST=127.0.0.1
PORT=4021

FRONTEND_BASE_URL=http://127.0.0.1:3021

# Media API (validate feedback screenshot attachments)
MEDIA_API_BASE_URL=http://127.0.0.1:4013/api/v1

# Cursor /feedback-fix MCP (tooling/support-feedback-mcp) — NOT read by Support backend at runtime.
# Local dev: set here or on the support-feedback MCP server in Cursor Settings → MCP (never commit tokens).
# IIS / env:apply: copied from repo-root production.env (SUPPORT_FEEDBACK_BEARER_TOKEN).
# Token: super_admin access JWT from browser localStorage key support_auth after login to Support.
# SUPPORT_API_BASE_URL=http://127.0.0.1:4021/api/v1
# SUPPORT_FEEDBACK_BEARER_TOKEN=

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
