# =============================================================================
# Production env (IIS) — single source of truth
# =============================================================================
# Copy to production.env (gitignored) on the deploy/ops machine, fill values,
# then run:  npm run env:apply   or   npm run deploy:<service>
#
# Local npm run dev does NOT use this file — keep per-service frontend/.env
# and backend/.env from each layer's .env.example.
#
# WARNING: env:apply overwrites every service's backend/.env and
# frontend/.env.production. Run only on the production/ops machine.
#
# Optional overrides (omit to use apply defaults): ACCESS_TOKEN_EXPIRY_SECONDS,
# REFRESH_TOKEN_EXPIRY_DAYS, EMAIL_VERIFICATION_EXPIRY_HOURS, MEDIA_MAX_FILE_SIZE_BYTES,
# MEDIA_ALLOWED_MIME_TYPES, MEDIA_S3_BUCKET, MEDIA_S3_REGION, SMTP_PORT, SMTP_SECURE,
# SMTP_TLS_REJECT_UNAUTHORIZED, QUEUE_WORKER_INTERVAL_MS, OTP_TTL_SECONDS,
# OTP_MAX_ATTEMPTS, DEVICE_STALE_MS, PROCESSING_TIMEOUT_MS, INVOICE_GENERATOR_INTERVAL_MS.
# =============================================================================

# --- Shared DB host (DB_NAME differs per service below) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# --- Shared secrets (written once; apply script copies into every consumer) ---
JWT_SECRET=
EMAIL_SERVICE_API_KEY=
SMS_SERVICE_API_KEY=
IDENTITY_SERVICE_API_KEY=
DATA_SERVICE_API_KEY=
PAYMENT_SERVICE_API_KEY=
DESIGN_SERVICE_API_KEY=
WEBONONE_SERVICE_API_KEY=

# Google OAuth (Identity BE + FE). Optional — leave empty to disable Google Sign-In.
GOOGLE_CLIENT_ID=

# Optional — company maps (WebOnOne) + catalog map (Website). Leave empty to hide maps.
GOOGLE_MAPS_API_KEY=

# OAuth / return_url patterns (Identity BE + FE). Example: https://*.webonone.com
ALLOWED_REDIRECT_URIS=https://*.webonone.com

# --- Public origins (IIS hosts). Apply derives VITE_* and peer API bases. ---
ORIGIN_WEBONONE=https://app.webonone.com
ORIGIN_IDENTITY=https://identity.webonone.com
ORIGIN_MEDIA=https://media.webonone.com
ORIGIN_EMAIL=https://email.webonone.com
ORIGIN_DATA=https://data.webonone.com
ORIGIN_SMS=https://sms.webonone.com
ORIGIN_PAYMENT=https://payment.webonone.com
ORIGIN_WEBSITE=https://www.webonone.com
ORIGIN_DESIGN=https://design.webonone.com

# --- Per-service database names ---
IDENTITY_DB_NAME=identity
WEBONONE_DB_NAME=webonone_v2
MEDIA_DB_NAME=webonone_media
EMAIL_DB_NAME=webonone_email
DATA_DB_NAME=webonone_data
SMS_DB_NAME=webonone_sms
PAYMENT_DB_NAME=webonone_payment
WEBSITE_DB_NAME=webonone_web
DESIGN_DB_NAME=webonone_design

# Platform super-admin (Identity users_roles; also copied to WebOnOne BE)
# Set SUPER_ADMIN_USER_ID to the Identity user id (CHAR(21)), then:
#   npm run migrate -w identity-root && npm run seed -w @webonone/identity-backend
SUPER_ADMIN_USER_ID=
SUPER_ADMIN_DISPLAY_NAME=Super Admin

# --- Media-only ---
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_STORAGE_PATH=./storage

# --- Email-only (SMTP) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@webonone.com
SMTP_FROM_NAME=WebOnOne

# --- Payment-only ---
SYSTEM_MONTHLY_AMOUNT_LKR=3000
BILLING_TIMEZONE=Asia/Colombo
INVOICE_DUE_DAYS=14
