DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_sms

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4016

SMS_SERVICE_API_KEY=dev-sms-service-key

# OTP settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Gateway device / worker settings
DEVICE_STALE_MS=120000
PROCESSING_TIMEOUT_MS=120000
QUEUE_WORKER_INTERVAL_MS=5000

FRONTEND_BASE_URL=http://127.0.0.1:3016

# Production (IIS): copy this file to backend/.env before deploy
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_sms
# JWT_SECRET=<same-as-identity-backend-jwt-secret>
# HOST=127.0.0.1
# SMS_SERVICE_API_KEY=<shared-sms-service-key>
# FRONTEND_BASE_URL=https://sms.webonone.com
