# SMS frontend (Vite) — browser-safe config only (VITE_*)
VITE_API_BASE_URL=http://127.0.0.1:4016/api/v1

# Identity peer (login + profile + token exchange)
VITE_IDENTITY_ORIGIN=http://127.0.0.1:3011
VITE_IDENTITY_API_BASE_URL=http://127.0.0.1:4011/api/v1

# WebOnOne core shell (for platform embed + core nav)
VITE_WEBONONE_ORIGIN=http://127.0.0.1:3010

# Allowed iframe parent origins (embed mode)
VITE_ALLOWED_PARENT_ORIGINS=http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:3016

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
