DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_web

HOST=127.0.0.1
PORT=4018

# WebOnOne internal catalog search (service-to-service)
WEBONONE_API_BASE_URL=http://127.0.0.1:4010
WEBONONE_SERVICE_API_KEY=dev-webonone-service-key

FRONTEND_BASE_URL=http://127.0.0.1:3018

# Production (IIS): copy this file to backend/.env before deploy
#
# Website public site: https://www.webonone.com
# WebOnOne app (login + internal catalog search): https://app.webonone.com
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_web
# HOST=127.0.0.1
# WEBONONE_API_BASE_URL=https://app.webonone.com
# WEBONONE_SERVICE_API_KEY=<same value as webonone-v2/backend/.env>
# FRONTEND_BASE_URL=https://www.webonone.com
