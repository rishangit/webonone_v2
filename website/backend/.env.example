DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_web

HOST=127.0.0.1
PORT=4018

# WebOnOne internal catalog search (service-to-service)
WEBONONE_API_BASE_URL=http://127.0.0.1:4010
WEBONONE_SERVICE_API_KEY=dev-webonone-service-key

FRONTEND_BASE_URL=http://127.0.0.1:3018

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
