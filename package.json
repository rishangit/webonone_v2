{
  "name": "webonone-platform",
  "private": true,
  "workspaces": [
    "ui-kit",
    "ui-kit/package",
    "ui-kit/showcase",
    "identity",
    "identity/frontend",
    "identity/backend",
    "webonone-v2",
    "webonone-v2/frontend",
    "webonone-v2/backend",
    "media",
    "media/frontend",
    "media/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n ui-kit,identity,webonone,media -c magenta,blue,cyan,yellow \"npm run dev:ui-kit\" \"npm run dev:identity\" \"npm run dev:webonone\" \"npm run dev:media\"",
    "dev:ui-kit": "npm run dev -w ui-kit-root",
    "dev:identity": "npm run dev -w identity-root",
    "dev:webonone": "npm run dev -w webonone-v2-root",
    "dev:media": "npm run dev -w media-root",
    "build:ui-kit": "npm run build -w @webonone/ui-kit",
    "build:platform-nav": "npm run build -w @webonone/platform-nav",
    "build:media-embed": "npm run build -w @webonone/media-embed",
    "build:identity": "npm run build -w identity-root",
    "deploy:identity": "npm run deploy -w identity-root",
    "build:webonone": "npm run build -w webonone-v2-root",
    "build:media": "npm run build -w media-root",
    "deploy:media": "npm run deploy -w media-root",
    "deploy:webonone": "npm run deploy -w webonone-v2-root",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
