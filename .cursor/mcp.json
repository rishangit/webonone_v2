{
  "mcpServers": {
    "clickup": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.clickup.com/mcp"]
    },
    "support-feedback": {
      "command": "node",
      "args": ["tooling/support-feedback-mcp/dist/index.js"],
      "env": {
        "SUPPORT_API_BASE_URL": "https://staging-support.webonone.com/api/v1",
        "SUPPORT_FEEDBACK_BEARER_TOKEN": "suport_feedback_bearer_token"
      }
    }
  }
}
