{
  // IDE automation — ONE-TIME SETUP (per machine):
  //   0. MCP: `.cursor/mcp.json` — Support Feedback + GitHub (`GITHUB_TOKEN` env var).
  //   1. Cursor Settings → Agents → Run Mode → Allowlist (uses this file) OR Run Everything.
  //   2. Fully quit and restart Cursor (Cmd/Ctrl+Q) after editing this file — Reload Window is not enough.
  //   3. If prompts persist: Agents → Inline Editing & Terminal → enable Legacy Terminal Tool, then restart.
  //   4. Piped commands (git | findstr) check EACH segment — findstr/rg/Select-String must be listed.
  //   6. On Windows: use git commit -m "msg" only — never @' here-strings; allowlist misparses them.
  //   5. Auto-Run in Sandbox can ignore allowlists; use Allowlist or Run Everything instead.
  // Docs: https://cursor.com/docs/reference/permissions
  "mcpAllowlist": [
    "github:*",
    "support-feedback:*"
  ],
  "terminalAllowlist": [
    "git",
    "gh",
    "npm",
    "npx",
    "node",
    "yarn",
    "pnpm",
    "cargo",
    "make",
    "python",
    "pip",
    "cd",
    "powershell",
    "pwsh",
    "cmd",
    "tsc",
    "eslint",
    "prettier",
    "curl",
    "wget",
    "findstr",
    "where",
    "rg",
    "grep",
    "Select-String",
    "concurrently",
    "git branch -a | findstr",
    "git branch -a | rg",
    "git branch -a | Select-String"
  ],
  "autoRun": {
    "allow_instructions": [
      "During /feedback-fix workflows, allow Support Feedback MCP (feedback_list, feedback_get, feedback_update_status), SwitchMode to plan for the planning phase, writes under spec/{ticket}/ (spec.md, plan.md, development-summary.md), git fetch/checkout/commit/push to deploy_staging, and all shell commands required for implementation, type-check, lint, and tests in touched workspaces.",
      "Allow GitHub MCP tools when creating branches, pull requests, or checking CI status for spec branches.",
      "Allow WebFetch and WebSearch when gathering external API or documentation references for spec or implementation work.",
      "On Windows PowerShell, use single-line git commit -m \"message\" only. Never use bash HEREDOC or PowerShell here-strings (@' ... '@); Cursor allowlist treats here-string bodies as separate commands."
    ],
    "block_instructions": []
  }
}
