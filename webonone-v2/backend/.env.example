DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql123!@@
DB_NAME=webonone_v2

HOST=127.0.0.1

# Local dev. On IIS, HttpPlatformHandler sets PORT; backend loads this file directly when IIS_NODE_HOSTED=1.
PORT=4010

# Must match identity/backend/.env JWT_SECRET
JWT_SECRET=dev-jwt-secret-change-in-production

# Super-admin role lives in Identity users_roles — copy user id from Identity DB, then:
# npm run seed -w @webonone/identity-backend
SUPER_ADMIN_USER_ID=GtiaBA78ucELI6Gyh6qKw
SUPER_ADMIN_EMAIL=superadmin@webonone.local
SUPER_ADMIN_DISPLAY_NAME=Super Admin

# Identity service (role API for WebOnOne backend)
IDENTITY_API_BASE_URL=http://127.0.0.1:4011
IDENTITY_SERVICE_API_KEY=dev-identity-service-key
IDENTITY_DB_NAME=identity

# Email service (internal transactional send only)
EMAIL_API_BASE_URL=http://127.0.0.1:4014
EMAIL_SERVICE_API_KEY=dev-email-service-key

# SMS service (welcome template seed on company registration)
SMS_API_BASE_URL=http://127.0.0.1:4016
SMS_SERVICE_API_KEY=dev-sms-service-key

# Payment service (system subscription billing on company approve)
PAYMENT_API_BASE_URL=http://127.0.0.1:4017
PAYMENT_SERVICE_API_KEY=dev-payment-service-key

# Data service (internal catalog API)
DATA_API_BASE_URL=http://127.0.0.1:4015
DATA_SERVICE_API_KEY=dev-data-service-key

# Production (IIS): copy this file to backend/.env before npm run deploy:webonone
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_v2
# HOST=127.0.0.1
# JWT_SECRET=<same-as-identity-backend-jwt-secret>
# SUPER_ADMIN_USER_ID=<identity-user-id>
# SUPER_ADMIN_EMAIL=superadmin@webonone.local
# SUPER_ADMIN_DISPLAY_NAME=Super Admin
# IDENTITY_API_BASE_URL=https://identity.webonone.com
# IDENTITY_SERVICE_API_KEY=<same value as identity/backend/.env>
# EMAIL_API_BASE_URL=https://email.webonone.com
# EMAIL_SERVICE_API_KEY=<same value as email/backend/.env>
# DATA_API_BASE_URL=https://data.webonone.com
# DATA_SERVICE_API_KEY=<same value as data/backend/.env>
