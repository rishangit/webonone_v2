DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql123!@@
DB_NAME=webonone_v2

# Local dev. On IIS, HttpPlatformHandler sets PORT; backend loads this file directly when IIS_NODE_HOSTED=1.
PORT=4000

# Must match identity/backend/.env JWT_SECRET
JWT_SECRET=dev-jwt-secret-change-in-production

# Super-admin role in users_roles (linked to Identity user_id, not email).
# 1. Register/login in Identity as SUPER_ADMIN_EMAIL
# 2. Copy users.id from Identity DB: SELECT id FROM identity.users WHERE email = 'superadmin@webonone.local';
# 3. npm run seed -w @webonone/webonone-backend
SUPER_ADMIN_USER_ID=GtiaBA78ucELI6Gyh6qKw
SUPER_ADMIN_EMAIL=superadmin@webonone.local
SUPER_ADMIN_DISPLAY_NAME=Super Admin

# Email service (internal transactional send + role sync)
EMAIL_API_BASE_URL=http://localhost:4004
EMAIL_SERVICE_API_KEY=

# Production (IIS): copy this file to backend/.env before npm run deploy:webonone
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_v2
# JWT_SECRET=<same-as-identity-backend-jwt-secret>
# SUPER_ADMIN_USER_ID=<identity-user-id>
# SUPER_ADMIN_EMAIL=superadmin@webonone.local
# SUPER_ADMIN_DISPLAY_NAME=Super Admin
# EMAIL_API_BASE_URL=https://email.webonone.com
# EMAIL_SERVICE_API_KEY=<same value as email/backend/.env>
