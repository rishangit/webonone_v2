VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_IDENTITY_ORIGIN=http://localhost:3001
VITE_IDENTITY_API_BASE_URL=http://localhost:4001/api/v1
VITE_MEDIA_ORIGIN=http://localhost:3003
VITE_MEDIA_PICKER_URL=http://localhost:3003/picker
VITE_MEDIA_UPLOAD_URL=http://localhost:3003/upload
VITE_MEDIA_API_BASE_URL=http://localhost:4003/api/v1
VITE_DEMO_SITE_ID=demo00000000000000001
# Production (IIS): copy this file to frontend/.env.production before npm run deploy:webonone
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_MEDIA_ORIGIN=https://media.webonone.com
# VITE_MEDIA_PICKER_URL=https://media.webonone.com/picker
# VITE_MEDIA_UPLOAD_URL=https://media.webonone.com/upload
# VITE_MEDIA_API_BASE_URL=https://media.webonone.com/api/v1
#
# Login callback, Identity profile URL, and Identity API are configured separately.
# Local dev: FE (3001) and BE (4001) are different origins — set both Identity URLs.
# Production (IIS): Identity serves SPA + API from one host — same domain, API includes /api/v1.
