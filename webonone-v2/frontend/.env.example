VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_IDENTITY_ORIGIN=http://localhost:3001
VITE_IDENTITY_API_BASE_URL=http://localhost:4001/api/v1
VITE_MEDIA_ORIGIN=http://localhost:3003
VITE_EMAIL_ORIGIN=http://localhost:3004

# Production (IIS): copy this file to frontend/.env.production before npm run deploy:webonone
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_MEDIA_ORIGIN=https://media.webonone.com
# VITE_EMAIL_ORIGIN=https://email.webonone.com
#
# Login callback is derived at runtime from window.location.origin + /callback.
# Media picker (/picker) and upload (/upload) URLs are derived from VITE_MEDIA_ORIGIN.
# Email admin app URL is derived from VITE_EMAIL_ORIGIN.
# Local dev: FE and BE run on different ports — set both origin and API base per peer service.
# Production (IIS): each service serves SPA + API from one host — API base is /api/v1 on same origin.
