VITE_API_BASE_URL=http://127.0.0.1:4010/api/v1
VITE_IDENTITY_ORIGIN=http://127.0.0.1:3011
VITE_IDENTITY_API_BASE_URL=http://127.0.0.1:4011/api/v1
VITE_MEDIA_ORIGIN=http://127.0.0.1:3013
VITE_EMAIL_ORIGIN=http://127.0.0.1:3014
VITE_DATA_ORIGIN=http://127.0.0.1:3015
VITE_DATA_API_BASE_URL=http://127.0.0.1:4015/api/v1
VITE_SMS_ORIGIN=http://127.0.0.1:3016

# Optional — company location map / Places on Company profile (Location card).
# Without this key the page still works; address fields only + map unavailable message.
# VITE_GOOGLE_MAPS_API_KEY=

# Production (IIS): copy this file to frontend/.env.production before npm run deploy:webonone
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_MEDIA_ORIGIN=https://media.webonone.com
# VITE_EMAIL_ORIGIN=https://email.webonone.com
# VITE_DATA_ORIGIN=https://data.webonone.com
# VITE_DATA_API_BASE_URL=https://data.webonone.com/api/v1
# VITE_SMS_ORIGIN=https://sms.webonone.com
# VITE_GOOGLE_MAPS_API_KEY=
#
# Login callback is derived at runtime from window.location.origin + /callback.
# Media picker (/picker) and upload (/upload) URLs are derived from VITE_MEDIA_ORIGIN.
# Local peer origins use http://127.0.0.1 (not localhost) so postMessage / iframe origins match.
# Email admin app URL is derived from VITE_EMAIL_ORIGIN.
# Data admin app URL is derived from VITE_DATA_ORIGIN.
# Data API base hydrates live-linked company catalog items from the library.
# SMS admin app URL is derived from VITE_SMS_ORIGIN.
# Local dev: FE and BE run on different ports — set both origin and API base per peer service.
# Production (IIS): each service serves SPA + API from one host — API base is /api/v1 on same origin.
