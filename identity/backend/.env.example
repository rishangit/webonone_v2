DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql123!@@
DB_NAME=identity

HOST=127.0.0.1

# Local dev. On IIS, HttpPlatformHandler sets PORT; backend loads this file directly when IIS_NODE_HOSTED=1.
PORT=4011

JWT_SECRET=dev-jwt-secret-change-in-production

# Access JWT lifetime in seconds (604800 = 7 days). Consumers store the access token until exp — SSO re-issues via Identity session when needed.
ACCESS_TOKEN_EXPIRY_SECONDS=604800
REFRESH_TOKEN_EXPIRY_DAYS=7

ALLOWED_REDIRECT_URIS=http://127.0.0.1:*

# Email service origin (no /api/v1 suffix — client appends /api/v1/internal/...)
EMAIL_API_BASE_URL=http://127.0.0.1:4014
EMAIL_SERVICE_API_KEY=dev-email-service-key

# SMS service origin (no /api/v1 suffix — client appends /api/v1/internal/...)
# Optional: enables phone OTP + transactional SMS via the SMS microservice.
SMS_API_BASE_URL=http://127.0.0.1:4016
SMS_SERVICE_API_KEY=dev-sms-service-key

# Identity frontend origin for links in transactional emails
IDENTITY_FRONTEND_ORIGIN=http://127.0.0.1:3011

# WebOnOne frontend origin for invite set-password links (forgot-password flow)
WEBONONE_FRONTEND_ORIGIN=http://127.0.0.1:3010

# Email verification token lifetime (hours)
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Google Sign-In (optional — POST /auth/google returns 503 when empty)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env (same Web application Client ID)
GOOGLE_CLIENT_ID=614019905250-ru7pmllv7of3jq24fnprhs7c0ni9rdgf.apps.googleusercontent.com

# Platform super-admin role (users_roles in Identity DB)
# Set to the Identity user id (CHAR(21)) for production super admin, then run:
#   npm run migrate -w identity-root && npm run seed -w @webonone/identity-backend
SUPER_ADMIN_USER_ID=
SUPER_ADMIN_EMAIL=superadmin@webonone.local
SUPER_ADMIN_DISPLAY_NAME=Super Admin

# Service-to-service key for WebOnOne backend role mutations
IDENTITY_SERVICE_API_KEY=dev-identity-service-key

# WebOnOne in-app notifications (internal ingest). Soft-fail when unset.
WEBONONE_API_BASE_URL=http://127.0.0.1:4010
WEBONONE_SERVICE_API_KEY=dev-webonone-service-key

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
