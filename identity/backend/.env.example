DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql123!@@
DB_NAME=identity

HOST=127.0.0.1

# Local dev. On IIS, HttpPlatformHandler sets PORT; backend loads this file directly when IIS_NODE_HOSTED=1.
PORT=4001

JWT_SECRET=dev-jwt-secret-change-in-production

# Access JWT lifetime in seconds (86400 = 24 hours). WebOnOne stores only the access token today — keep this long enough for a work session.
ACCESS_TOKEN_EXPIRY_SECONDS=86400
REFRESH_TOKEN_EXPIRY_DAYS=7

ALLOWED_REDIRECT_URIS=http://localhost:*

# Email service (internal transactional send)
EMAIL_API_BASE_URL=http://localhost:4004
EMAIL_SERVICE_API_KEY=dev-email-service-key

# Identity frontend origin for links in transactional emails
IDENTITY_FRONTEND_ORIGIN=http://localhost:3001

# Email verification token lifetime (hours)
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Google Sign-In (optional — POST /auth/google returns 503 when empty)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env (same Web application Client ID)
GOOGLE_CLIENT_ID=614019905250-ru7pmllv7of3jq24fnprhs7c0ni9rdgf.apps.googleusercontent.com

# Production (IIS): copy this file to backend/.env before npm run deploy:identity
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=identity
# HOST=127.0.0.1
# JWT_SECRET=<production-jwt-secret>
# ACCESS_TOKEN_EXPIRY_SECONDS=86400
# REFRESH_TOKEN_EXPIRY_DAYS=7
# ALLOWED_REDIRECT_URIS=https://*.webonone.com
# EMAIL_API_BASE_URL=https://email.webonone.com/api/v1
# EMAIL_SERVICE_API_KEY=<shared-email-service-key>
# IDENTITY_FRONTEND_ORIGIN=https://identity.webonone.com
# EMAIL_VERIFICATION_EXPIRY_HOURS=24
# GOOGLE_CLIENT_ID=<production-oauth-client-id>
