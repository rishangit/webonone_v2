VITE_API_BASE_URL=http://localhost:4011/api/v1

# Media service (profile photo selector embed)
VITE_MEDIA_ORIGIN=http://localhost:3013

# Email service (platform nav handoff)
VITE_EMAIL_ORIGIN=http://localhost:3014

# WebOnOne (platform nav handoff + iframe embed parent)
VITE_WEBONONE_ORIGIN=http://localhost:3010
VITE_WEBONONE_API_BASE_URL=http://localhost:4010/api/v1

# Comma-separated parent origins allowed for platform iframe embeds.
# 3012 enables the UI Kit showcase Identity user-picker demo.
VITE_ALLOWED_PARENT_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011,http://localhost:3012,http://127.0.0.1:3012

# Comma-separated redirect URI patterns for OAuth login and profile return_url validation.
# Supports exact URIs, https://*.yourdomain.com (any subdomain/path), and http://localhost:* for dev.
VITE_ALLOWED_REDIRECT_URIS=http://localhost:*

# Google Sign-In (optional — button hidden when empty)
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# 2. Authorized JavaScript origins: http://localhost:3011 (and production Identity FE origin)
# 3. No redirect URI needed for GIS id_token flow
# 4. Configure OAuth consent screen; add test users if app is in Testing mode
# 5. Copy Client ID here AND set the same value as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=614019905250-ru7pmllv7of3jq24fnprhs7c0ni9rdgf.apps.googleusercontent.com

# Production (IIS): copy this file to frontend/.env.production before npm run deploy:identity
#
# VITE_API_BASE_URL=/api/v1
# VITE_MEDIA_ORIGIN=https://media.webonone.com
# VITE_EMAIL_ORIGIN=https://email.webonone.com
# VITE_WEBONONE_ORIGIN=https://app.webonone.com
# VITE_WEBONONE_API_BASE_URL=https://app.webonone.com/api/v1
# VITE_ALLOWED_PARENT_ORIGINS=https://app.webonone.com
# VITE_ALLOWED_REDIRECT_URIS=https://*.webonone.com
# VITE_GOOGLE_CLIENT_ID=<production-oauth-client-id>
