VITE_API_BASE_URL=http://127.0.0.1:4011/api/v1

# Media service (profile photo selector embed)
VITE_MEDIA_ORIGIN=http://127.0.0.1:3013

# Email service (platform nav handoff)
VITE_EMAIL_ORIGIN=http://127.0.0.1:3014

# SMS service (platform nav handoff)
VITE_SMS_ORIGIN=http://127.0.0.1:3016

# WebOnOne (platform nav handoff + iframe embed parent)
VITE_WEBONONE_ORIGIN=http://127.0.0.1:3010
VITE_WEBONONE_API_BASE_URL=http://127.0.0.1:4010/api/v1

# Design service (form fill history + published forms)
VITE_DESIGN_ORIGIN=http://127.0.0.1:3019
VITE_DESIGN_API_BASE_URL=http://127.0.0.1:4019/api/v1

# Comma-separated parent origins allowed for platform iframe embeds.
# 3012 enables the UI Kit showcase Identity user-picker demo.
# 3018 enables public website silent SSO (/auth/silent-sso).
VITE_ALLOWED_PARENT_ORIGINS=http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:3012,http://127.0.0.1:3018

# Public website (global logout clear-session chain)
VITE_WEBSITE_ORIGIN=http://127.0.0.1:3018

# Comma-separated redirect URI patterns for OAuth login and profile return_url validation.
# Supports exact URIs, https://*.yourdomain.com (any subdomain/path), and http://127.0.0.1:* for dev.
# Includes public website auth-code return (e.g. http://127.0.0.1:3018/ locally, https://www.webonone.com/ in prod).
VITE_ALLOWED_REDIRECT_URIS=http://127.0.0.1:*

# Google Sign-In (optional — button hidden when empty)
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# 2. Authorized JavaScript origins: http://127.0.0.1:3011 (and production Identity FE origin)
# 3. No redirect URI needed for GIS id_token flow
# 4. Configure OAuth consent screen; add test users if app is in Testing mode
# 5. Copy Client ID here AND set the same value as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=614019905250-ru7pmllv7of3jq24fnprhs7c0ni9rdgf.apps.googleusercontent.com

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
