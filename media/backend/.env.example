DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_media

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4013

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_STORAGE_PATH=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:4013/api/v1
MEDIA_MAX_FILE_SIZE_BYTES=26214400
MEDIA_ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,text/plain

# Optional — only when MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=

# Production (IIS): copy this file to backend/.env before npm run deploy:media
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=<production-db-user>
# DB_PASSWORD=<production-db-password>
# DB_NAME=webonone_media
# JWT_SECRET=<same-as-identity-backend-jwt-secret>
# HOST=127.0.0.1
# MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_STORAGE_PATH=./storage
# MEDIA_PUBLIC_BASE_URL=https://media.webonone.com/api/v1
# MEDIA_MAX_FILE_SIZE_BYTES=26214400
# MEDIA_ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,text/plain
