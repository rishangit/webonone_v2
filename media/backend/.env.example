DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_media

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4013

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_STORAGE_PATH=./storage
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4013/api/v1
MEDIA_MAX_FILE_SIZE_BYTES=26214400
MEDIA_ALLOWED_MIME_TYPES=image/*,video/*,application/pdf,text/plain

# Optional — only when MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
