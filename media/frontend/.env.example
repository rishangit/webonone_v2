VITE_API_BASE_URL=http://127.0.0.1:4013/api/v1
VITE_IDENTITY_ORIGIN=http://127.0.0.1:3011
VITE_IDENTITY_API_BASE_URL=http://127.0.0.1:4011/api/v1
VITE_ALLOWED_PARENT_ORIGINS=http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:3012,http://127.0.0.1:3013,http://127.0.0.1:3015

# Production (IIS): copy this file to frontend/.env.production before npm run deploy:media
#
# VITE_API_BASE_URL=/api/v1
# VITE_IDENTITY_ORIGIN=https://identity.webonone.com
# VITE_IDENTITY_API_BASE_URL=https://identity.webonone.com/api/v1
# VITE_ALLOWED_PARENT_ORIGINS=https://app.webonone.com,https://identity.webonone.com,https://data.webonone.com
#
# Local dev: FE and BE run on different ports — set both origin and API base for Identity.
# Production (IIS): API base is /api/v1 on same host; include every consumer origin that embeds Media routes.
# Use 127.0.0.1 (not localhost) to match Vite host bindings and showcase embeds.
