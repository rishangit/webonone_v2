# URL the desktop window loads. Do not use file:// — login and peer iframes need a real origin.
# Local (run `npm run dev` from the repo root first):
WEBONONE_APP_URL=http://127.0.0.1:3010
# Production installer defaults to https://app.webonone.com when this file is absent.
# WEBONONE_APP_URL=https://app.webonone.com
