DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webonone_payment

JWT_SECRET=dev-jwt-secret-change-in-production
HOST=127.0.0.1
PORT=4017

PAYMENT_SERVICE_API_KEY=dev-payment-service-key
SYSTEM_MONTHLY_AMOUNT_LKR=3000
BILLING_TIMEZONE=Asia/Colombo
INVOICE_GENERATOR_INTERVAL_MS=3600000
# Days after billing period end until payment is due
INVOICE_DUE_DAYS=14
FRONTEND_BASE_URL=http://127.0.0.1:3017

# Production (IIS): do not copy this file.
# Edit repo-root production.env (from production.env.example), then npm run deploy:<service>
# (runs env:apply → writes backend/.env + frontend/.env.production).
